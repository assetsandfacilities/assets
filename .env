VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=change-this-to-a-long-random-secret
JWT_TTL=30
BCRYPT_ROUNDS=12


# Minimum advance notice (in days) for facility reservations. 0 allows same-day booking.
FMO_RESERVATION_LEAD_DAYS=2

# ---------------------------------------------------------------------------
# One-time password (OTP) controls — panel revision
# Expiry is 2 minutes; a code may be resent 3 times, after which that address
# waits 50 minutes. NU_OTP_IP_MAX is deliberately loose because a campus puts
# many students behind one public IP.
# ---------------------------------------------------------------------------
NU_OTP_EXPIRY_MINUTES=2
NU_OTP_COOLDOWN_SECONDS=60
NU_OTP_RESEND_MAX=3
NU_OTP_RESEND_LOCK_MINUTES=50
NU_OTP_IP_MAX=30
NU_OTP_IP_DECAY_MINUTES=15

