APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# For TiDB Cloud / production (port 4000, TLS required) -- set this on the HOST's
# environment variables, not locally, or every local/XAMPP MySQL connection will fail
# with a confusing "MySQL server has gone away" error since local MySQL has no SSL cert:
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PRODUCTION EMAIL (verification codes will NOT reach real inboxes without
# this). MAIL_MAILER=log above is fine for local testing only -- it just
# writes the "email" into storage/logs/laravel.log instead of sending it,
# which is why codes worked on localhost but never arrived once deployed.
#
# To actually send real emails in production, use your own Gmail account as
# the sender (no separate service to sign up for). Steps:
#
# 1. Go to https://myaccount.google.com/security and turn ON 2-Step
#    Verification for that Gmail account (required before App Passwords
#    are available).
# 2. Go to https://myaccount.google.com/apppasswords, create a new App
#    Password (name it e.g. "NU Clark Mail"), and copy the 16-character
#    code it gives you (looks like: abcd efgh ijkl mnop).
# 3. Set these on your HOST (Railway dashboard env vars, or this .env file
#    on the server -- not on localhost):
#
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=your-gmail-address@gmail.com
# MAIL_PASSWORD=your-16-character-app-password
# MAIL_FROM_ADDRESS="your-gmail-address@gmail.com"
# MAIL_FROM_NAME="NU Clark Asset Management System"
#
# Notes:
# - MAIL_USERNAME and MAIL_FROM_ADDRESS must be the SAME Gmail address.
# - MAIL_PASSWORD is the App Password from step 2, NOT your normal Gmail
#   login password (your real password will NOT work here).
# - Gmail caps sending at ~500 emails/day on a free account, which is
#   plenty for verification codes on a school/thesis system.
# - The recipient can still be any email address (Gmail, Outlook, anything);
#   these settings only control who is SENDING the mail, not who can receive it.
# ---------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=change-this-to-a-long-random-secret
JWT_TTL=30
BCRYPT_ROUNDS=12

# Secure read-only procurement / ERP export. Generate a long random value and
# configure the same value in the external ERP connector. Optional IP allow-list
# is comma-separated (leave empty when the ERP has no fixed egress IP).
ERP_API_KEY=change-this-to-a-long-random-erp-key
ERP_ALLOWED_IPS=

FMO_RESERVATION_LEAD_DAYS=2

# ---------------------------------------------------------------------------
# One-time password (OTP) controls — panel revision
# Expiry is 2 minutes; a code may be resent 3 times, after which that address
# waits 50 minutes. NU_OTP_IP_MAX is deliberately loose because a campus puts
# many students behind one public IP.
# ---------------------------------------------------------------------------
NU_OTP_EXPIRY_MINUTES=2
NU_OTP_COOLDOWN_SECONDS=60
NU_OTP_RESEND_MAX=3
NU_OTP_RESEND_LOCK_MINUTES=50
NU_OTP_IP_MAX=30
NU_OTP_IP_DECAY_MINUTES=15

